# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env ขึ้น git)

# เลือก provider ข้อมูลราคา: mock | finnhub
DATA_PROVIDER=mock

# คีย์สำหรับหุ้นสหรัฐ (ขอฟรีได้ที่ finnhub.io) — ใช้เมื่อ DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# คีย์ Claude สำหรับส่วนวิเคราะห์ AI (ขอที่ console.anthropic.com)
# ถ้าไม่ใส่ ระบบจะใช้สรุปแบบกฎ (rule-based) แทนและแจ้งให้ตั้งค่า
ANTHROPIC_API_KEY=

# รุ่นโมเดลที่ใช้วิเคราะห์
ANTHROPIC_MODEL=claude-opus-4-8

# secret สำหรับตรวจ webhook ของ TradingView (ตั้งเป็นค่าสุ่มยาว ๆ)
TRADINGVIEW_WEBHOOK_SECRET=change-me
