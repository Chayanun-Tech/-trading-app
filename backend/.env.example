# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env ขึ้น git)

# เลือก provider ข้อมูลราคา: yahoo | mock | finnhub
#   yahoo  = ราคาจริง ไม่ต้องใช้คีย์ รองรับ US + หุ้นไทย (.BK) + crypto (BTC-USD)  ← แนะนำ
#   mock   = ข้อมูลจำลองสำหรับทดสอบ
#   finnhub= หุ้นสหรัฐผ่าน Finnhub (ต้องมีคีย์)
DATA_PROVIDER=yahoo

# คีย์สำหรับหุ้นสหรัฐ (ขอฟรีได้ที่ finnhub.io) — ใช้เมื่อ DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# OANDA: ทอง/เงิน/forex ตรง TradingView (OANDA) เป๊ะ + เรียลไทม์
# สมัคร practice ฟรีที่ oanda.com → My Account → Manage API Access → Generate
# ตั้ง token แล้วระบบ route ทอง/forex ไป OANDA อัตโนมัติ (หุ้น/คริปโตยังใช้ Yahoo/Binance)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# ================= ผู้ให้บริการ AI (ใส่อย่างน้อย 1 เจ้า) =================
# เลือกเจ้าที่จะใช้: auto | anthropic | gemini | groq | openai
#   auto = ใช้เจ้าแรกที่มีคีย์ (ไล่ลำดับ anthropic > gemini > openai > groq)
LLM_PROVIDER=auto

# --- Gemini (ฟรี + อ่านภาพได้ → แนะนำสำหรับโหมดอัปโหลดภาพ) ---
# ขอคีย์ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (ฟรี + เร็วมาก แต่รุ่นหลักอ่านภาพไม่ได้ → ใช้โหมดข้อมูลได้) ---
# ขอคีย์ฟรีที่ https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Claude / Anthropic (เสียเงิน, อ่านภาพได้) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (เสียเงิน, อ่านภาพได้) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# secret สำหรับตรวจ webhook ของ TradingView (ตั้งเป็นค่าสุ่มยาว ๆ)
TRADINGVIEW_WEBHOOK_SECRET=change-me

# ================= Bitkub Auto Trade =================
# Paper mode does not need API keys. Real mode requires these keys and the explicit flag below.
BITKUB_API_KEY=
BITKUB_API_SECRET=

# Keep false until you are ready to send real Bitkub orders.
# Real mode also requires UI/API confirmation text: I UNDERSTAND REAL ORDERS
BITKUB_REAL_TRADING_ENABLED=false

# ================= Supabase / Postgres persistence =================
# Project URL from Supabase dashboard. This one is public and safe to keep here.
SUPABASE_URL=https://xiblqetehrnprycbkwyp.supabase.co
SUPABASE_ANON_KEY=

# Paste the Supabase Postgres connection string in backend/.env only.
# Do not commit the real value. Example formats:
# postgresql://postgres.xiblqetehrnprycbkwyp:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# postgresql://postgres:YOUR_PASSWORD@db.xiblqetehrnprycbkwyp.supabase.co:5432/postgres
DATABASE_URL=
